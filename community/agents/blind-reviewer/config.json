{
  "agent_name": "blind-reviewer",
  "enabled": true,
  "runtime": "opencode",
  "startup_delay": 0,
  "max_session_seconds": 255600,
  "max_crashes_per_day": 10,
  "working_directory": "",
  "timezone": "",
  "approval_rules": {
    "always_ask": [],
    "never_ask": []
  },
  "model": "",
  "_model_note": "Placeholder. The operator sets this. It must be a different lab from the builder's provider, so the review is actually independent, not just a second call to the same model.",
  "temperature": 0.0,
  "prompt": "{file:./prompts/reviewer.md}",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "deny",
      "**/verdict.json": "allow"
    },
    "todowrite": "deny",
    "bash": {
      "*": "deny",
      "git diff*": "allow",
      "git show*": "allow",
      "git log*": "allow",
      "git status*": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": {
      "*": "deny"
    }
  },
  "read_only": true,
  "crons": [
    {
      "name": "heartbeat",
      "type": "recurring",
      "interval": "4h",
      "prompt": "Read HEARTBEAT.md and follow its instructions."
    }
  ]
}
