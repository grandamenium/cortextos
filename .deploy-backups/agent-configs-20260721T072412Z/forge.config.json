{
  "agent_name": "forge",
  "model": "claude-sonnet-4-6",
  "enabled": true,
  "runtime": "claude-code",
  "startup_delay": 0,
  "max_session_seconds": 255600,
  "max_crashes_per_day": 10,
  "working_directory": "",
  "timezone": "America/Denver",
  "crons": [
    {
      "name": "heartbeat",
      "type": "recurring",
      "interval": "4h",
      "prompt": "Read HEARTBEAT.md and follow its instructions. Update your heartbeat, check inbox, and work on your highest priority task."
    }
  ],
  "ecosystem": {
    "local_version_control": {
      "enabled": true
    }
  },
  "day_mode_start": "06:00",
  "day_mode_end": "18:00",
  "communication_style": "professional",
  "approval_rules": {
    "always_ask": [
      "external-comms",
      "financial",
      "deployment",
      "data-deletion"
    ],
    "never_ask": []
  }
}